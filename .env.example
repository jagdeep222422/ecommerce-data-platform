# ==============================================================================
# Configuration Guide: Databricks & Azure Data Lake Storage (ADLS Gen2)
# Author: Jagdeep (jagdeepa1047@gmail.com)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AZURE CREDENTIALS & STORAGE (ADLS Gen2)
# ------------------------------------------------------------------------------
# Replace with your actual Azure Resource values:
AZURE_STORAGE_ACCOUNT_NAME="your_storage_account_name"
AZURE_CONTAINER_NAME="ecommerce"
AZURE_TENANT_ID="your_azure_ad_tenant_id"
AZURE_CLIENT_ID="your_service_principal_app_client_id"
AZURE_CLIENT_SECRET="your_service_principal_client_secret"

# ------------------------------------------------------------------------------
# 2. DATABRICKS WORKSPACE CREDENTIALS
# ------------------------------------------------------------------------------
# Found in your Databricks URL (e.g. https://adb-1234567890123456.7.azuredatabricks.net)
DATABRICKS_HOST="https://adb-your_workspace_id.azuredatabricks.net"
# Generated from: User Settings -> Developer -> Access Tokens -> Generate New Token
DATABRICKS_TOKEN="dapi_your_personal_access_token"

# ------------------------------------------------------------------------------
# 3. MOUNT POINT / STORAGE PATHS
# ------------------------------------------------------------------------------
# When mounted on Databricks:
BRONZE_MOUNT_PATH="/mnt/datalake/bronze"
SILVER_MOUNT_PATH="/mnt/datalake/silver"
GOLD_MOUNT_PATH="/mnt/datalake/gold"

# Or Direct ABFSS URIs (Recommended with Unity Catalog or Secret Scope):
# abfss://${AZURE_CONTAINER_NAME}@${AZURE_STORAGE_ACCOUNT_NAME}.dfs.core.windows.net/
